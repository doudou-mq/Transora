{
  "name": "transora-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Transora — 基于大模型的网页翻译浏览器扩展（MV3）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/smoke.mjs",
    "test:mock": "node test/e2e/mock-server.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
